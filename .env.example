# Core service
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Neo4j
NEO4J_AUTH=neo4j/password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis
REDIS_URL=redis://redis:6379

# Java parser bridge
JAVA_BRIDGE_JAR_PATH=./packages/java-parser/target/java-parser-0.1.0-all.jar

# Admin and GitHub (placeholders for later phases)
ADMIN_TOKEN=change-me
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
