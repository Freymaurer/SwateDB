# Core service runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Admin API authentication
# Must match the token entered in the frontend admin prompt.
ADMIN_TOKEN=change-me

# Neo4j
# NEO4J_AUTH is used by docker-compose for Neo4j container startup.
NEO4J_AUTH=neo4j/password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis
REDIS_URL=redis://redis:6379

# Java parser bridge
# In docker compose this is set to /opt/swatedb/java-parser.jar in backend.
# For local Node runs keep this pointed at your built parser artifact.
JAVA_BRIDGE_JAR_PATH=./packages/java-parser/target/java-parser-0.1.0-all.jar

# GitHub App integration
# Numeric GitHub App ID.
GITHUB_APP_ID=
# Multi-line PEM private key. In .env files use escaped newlines (\n).
GITHUB_PRIVATE_KEY=
# Webhook secret configured in GitHub App settings.
GITHUB_WEBHOOK_SECRET=
# Override for GitHub Enterprise if required.
GITHUB_API_BASE_URL=https://api.github.com

# Frontend local development
# Optional direct API URL for frontend fetch calls.
VITE_API_BASE_URL=
# Optional Vite proxy target used by npm run dev for frontend.
VITE_API_PROXY_TARGET=http://localhost:3000

# End-to-end smoke script targets (optional)
SMOKE_HEALTH_URL=http://localhost:3000/health
SMOKE_ARTEFACTS_URL=http://localhost:3000/artefacts?format=jsonld&page=1&pagesize=1
SMOKE_FRONTEND_URL=http://localhost:8080/
SMOKE_TIMEOUT_MS=15000
